---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products.js';
import { formatDate, publishedPosts, slugify } from '../../utils/blog.js';

export async function getStaticPaths() {
  const posts = publishedPosts(await getCollection('blog'));
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, category, tags, heroImage, heroAlt, relatedProducts } = post.data;
const { Content } = await post.render();

// Match frontmatter slugs against the product list so a typo silently drops the
// link rather than rendering a dead one.
const related = relatedProducts
  .map((slug) => products.find((p) => p.slug === slug))
  .filter(Boolean);
---
<BaseLayout title={`${title} | Pavilion Master Builders`} description={description}>
  <article class="blog-post">
    <!-- Deliberately a div, not a <header>: global.css styles the bare `header`
         element as the fixed site nav, so a <header> here gets pinned to the top
         of the viewport and dragged out of the document flow. -->
    <div class="blog-post-header">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><a href="/blog">Blog</a><span>/</span><span>{title}</span>
      </nav>
      <a class="blog-post-category" href={`/blog/category/${slugify(category)}`}>{category}</a>
      <h1>{title}</h1>
      <p class="blog-post-lede">{description}</p>
      <div class="blog-post-meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && <span>· Updated {formatDate(updatedDate)}</span>}
      </div>
    </div>

    {heroImage && (
      <div class="blog-post-hero">
        <img src={heroImage} alt={heroAlt ?? ''} />
      </div>
    )}

    <div class="blog-post-body">
      <Content />
    </div>

    {tags.length > 0 && (
      <div class="blog-post-tags">
        {tags.map((tag) => <span class="blog-tag">#{tag}</span>)}
      </div>
    )}

    {related.length > 0 && (
      <aside class="blog-post-related">
        <h2>Related solutions</h2>
        <div class="blog-related-grid">
          {related.map((p) => (
            <a class="blog-related-card" href={p.link}>
              <span class="blog-related-title">{p.title}</span>
              <span class="blog-related-more">View solution &rarr;</span>
            </a>
          ))}
        </div>
      </aside>
    )}

    <div class="blog-post-cta">
      <h2>Planning a project?</h2>
      <p>Talk to our team in Nairobi for a free, no-obligation quote.</p>
      <a class="btn-primary" href="/#contact">Request a Quote</a>
    </div>
  </article>
</BaseLayout>
