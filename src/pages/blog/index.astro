---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { publishedPosts, categoriesOf } from '../../utils/blog.js';

const posts = publishedPosts(await getCollection('blog'));
const categories = categoriesOf(posts);
---
<BaseLayout
  title="Building & Roofing Insights | Pavilion Master Builders"
  description="Practical guidance on roofing, light gauge steel, fibre cement and construction in Kenya from the Pavilion Master Builders team."
>
  <section class="blog-hero">
    <div class="blog-hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><span>Blog</span>
      </nav>
      <h1>Building &amp; Roofing Insights</h1>
      <p>Practical guidance on materials, methods and maintenance from our team across Nairobi, Kisumu and Eldoret.</p>
    </div>
  </section>

  <section class="blog-listing">
    {categories.length > 0 && (
      <div class="blog-categories">
        <span class="blog-categories-label">Browse:</span>
        <a href="/blog" class="blog-chip active">All ({posts.length})</a>
        {categories.map((c) => (
          <a href={`/blog/category/${c.slug}`} class="blog-chip">{c.name} ({c.count})</a>
        ))}
      </div>
    )}

    {posts.length === 0 ? (
      <p class="blog-empty">No articles published yet — check back soon.</p>
    ) : (
      <div class="blog-grid">
        {posts.map((post) => <BlogCard post={post} />)}
      </div>
    )}
  </section>
</BaseLayout>
