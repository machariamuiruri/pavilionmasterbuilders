---
import { navLinks } from '../data/site.js';
const currentPath = Astro.url.pathname;
const onProductPage = currentPath.startsWith('/products/');
// Only homepage sections take part in the scroll spy. Real routes like /blog must
// NOT get a key, or main.js would highlight them alongside the matching section.
const sectionKey = (href) => {
  if (href === '/') return 'home';
  if (href.includes('#')) return href.split('#')[1] || 'home';
  return undefined;
};

// Astro serves directory-style URLs with a trailing slash ('/blog/'), while
// navLinks stores them without ('/blog'). Comparing the two raw strings never
// matches, which is why the current product never highlighted in the dropdown.
const trim = (path) => path.replace(/\/+$/, '') || '/';
const isActive = (href) => {
  if (href.includes('#')) return false; // in-page anchors are handled by the scroll spy
  const target = trim(href);
  const here = trim(currentPath);
  return target === '/' ? here === '/' : here === target || here.startsWith(`${target}/`);
};
---
<header>
  <nav>
    <a href="/" class="brand">
      <img class="logo" src="/PAV.png" alt="Pavilion Master Builders logo" />
      <span class="brand-divider"></span>
      <span class="brand-text">
        <span class="brand-line brand-line-1">Pavilion</span>
        <span class="brand-line brand-line-2">Master Builders</span>
      </span>
    </a>
    <button class="nav-search-toggle" id="search-toggle" aria-label="Search the site" aria-expanded="false" aria-controls="site-search">
      <i class="fas fa-search" aria-hidden="true"></i>
    </button>
    <button class="nav-toggle" id="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-menu">
      <span></span><span></span><span></span>
    </button>
    <div class="nav-menu" id="nav-menu">
      <ul>
        {navLinks.map((link) => (
          link.dropdown ? (
            <li class="nav-solutions-dropdown">
              <a href={link.href} data-scroll-key="products" class={onProductPage ? 'active' : ''}>{link.label}</a>
              <div class="nav-dropdown-menu">
                {link.dropdown.map((item) => (
                  <a href={item.href} class={isActive(item.href) ? 'active' : ''}>{item.label}</a>
                ))}
              </div>
            </li>
          ) : (
            <li><a href={link.href} data-scroll-key={sectionKey(link.href)} class={isActive(link.href) ? 'active' : ''}>{link.label}</a></li>
          )
        ))}
      </ul>
      <button class="nav-cta" onclick="location.href='/#contact'">Get Quote</button>
    </div>
  </nav>

  <!-- Search panel. Results are rendered by src/scripts/search.js against
       /search.json, which is only fetched once the panel is first opened. -->
  <div class="site-search" id="site-search" hidden>
    <div class="site-search-inner">
      <div class="site-search-field">
        <i class="fas fa-search" aria-hidden="true"></i>
        <input
          id="site-search-input"
          type="text"
          placeholder="Search roofing, steel, finishes, guides…"
          aria-label="Search the site"
          autocomplete="off"
          role="combobox"
          aria-expanded="false"
          aria-controls="site-search-results"
          aria-autocomplete="list"
        />
        <button class="site-search-close" type="button" aria-label="Close search">×</button>
      </div>
      <ul class="site-search-results" id="site-search-results" role="listbox" aria-label="Search results"></ul>
      <p class="site-search-empty" hidden></p>
      <p class="site-search-hint">Press <kbd>/</kbd> to search · <kbd>Esc</kbd> to close</p>
    </div>
  </div>
</header>
