---
const heroImage = '/assets/hero/hero.jpg';
---
<section class="hero" id="home">
  <div class="hero-shapes">
    <div class="shape shape-1"></div>
    <div class="shape shape-2"></div>
  </div>

  <div class="hero-content">
    <div class="hero-text">
      <h1>Sustainable Building <span class="accent">Solutions</span> Across East Africa</h1>
      <p>Premium construction meets cutting-edge innovation. We transform visions into architectural excellence.</p>
      <div class="hero-ctas">
        <button class="btn-primary" onclick="location.href='#contact'">Start Your Project</button>
        <button class="btn-secondary" onclick="location.href='#products'">Explore Solutions</button>
      </div>
    </div>

    <div class="hero-image">
      <div class="hero-image-main">
        <img src={heroImage} alt="Modern Construction Excellence" />
      </div>
      <div class="floating-card floating-card-1">
        <div class="card-title">50-Year Warranty</div>
        <div class="card-value">Decra Roofing</div>
      </div>
      <div class="floating-card floating-card-2">
        <div class="card-title">40% Faster Build</div>
        <div class="card-value">LGS Technology</div>
      </div>
    </div>
  </div>
</section>
