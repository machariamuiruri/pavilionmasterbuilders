---
const heroImage = '/assets/hero/hero.jpg';
---
<section class="hero" id="home">
  <div class="hero-shapes">
    <div class="shape shape-1"></div>
    <div class="shape shape-2"></div>
  </div>

  <div class="hero-content">
    <div class="hero-text">
      <h1>Kenya&rsquo;s Preferred <span class="accent">Modular</span> Construction Contractor</h1>
      <p>We design and build modular homes, schools, clinics and commercial buildings across Kenya. The steel frames are made in our own Nairobi factory, so we control the programme from day one.</p>
      <div class="hero-ctas">
        <button class="btn-primary" onclick="location.href='#contact'">Request a Programme &amp; Budget</button>
        <button class="btn-secondary" onclick="location.href='#how-we-build'">See How We Build</button>
      </div>
    </div>

    <div class="hero-image">
      <div class="hero-image-main">
        <!-- Above the fold and the likely LCP element: stays eager, and asks the
             browser to prioritise it ahead of other images. -->
        <img src={heroImage} alt="A Pavilion builder checking a spirit level on site" fetchpriority="high" />
      </div>
      <div class="floating-card floating-card-1">
        <div class="card-title">Frames Rolled In</div>
        <div class="card-value">Our Own Factory</div>
      </div>
      <div class="floating-card floating-card-2">
        <div class="card-title">40% Faster Build</div>
        <div class="card-value">Modular Delivery</div>
      </div>
    </div>
  </div>
</section>
