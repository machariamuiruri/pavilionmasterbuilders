---
import { offices, email } from '../data/site.js';
const year = new Date().getFullYear();
---
<footer>
  <div class="footer-content">
    <div class="footer-section">
      <a href="/" class="brand footer-brand">
        <img class="logo" src="/PAV.png" alt="Pavilion Master Builders logo" />
        <span class="brand-divider"></span>
        <span class="brand-text">
          <span class="brand-line brand-line-1">Pavilion</span>
          <span class="brand-line brand-line-2">Master Builders</span>
        </span>
      </a>
      <p>Pavilion Master Builders is East Africa's premier sustainable construction provider. Quality. Innovation. Excellence. Every project, every time.</p>
      <div class="social-links">
        <a href="#" title="Instagram"><i class="fab fa-instagram"></i></a>
        <a href="#" title="Facebook"><i class="fab fa-facebook"></i></a>
        <a href="#" title="LinkedIn"><i class="fab fa-linkedin"></i></a>
        <a href="#" title="Twitter"><i class="fab fa-twitter"></i></a>
      </div>
    </div>

    <div class="footer-section footer-gold">
      <h3>{offices.length > 1 ? 'Our Offices' : 'Our Office'}</h3>
      {offices.map((o, i) => (
        <p style={i > 0 ? 'margin-top: 0.9rem;' : undefined}>
          <strong>{o.short}</strong><br />{o.address}<br />
          {o.phones.map((p, pi) => (
            <>{pi > 0 && ' / '}<a href={`tel:${p.tel}`}>{p.label}</a></>
          ))}
        </p>
      ))}
    </div>

    <div class="footer-section footer-gold">
      <h3>Get In Touch</h3>
      <p><a href={`mailto:${email}`}>{email}</a></p>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {year} Pavilion Master Builders Limited. Sustainable Building Solutions for East Africa. All Rights Reserved.</p>
  </div>
</footer>
