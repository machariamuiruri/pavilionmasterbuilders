---
import { formatDate } from '../utils/blog.js';

const { post } = Astro.props;
const { title, description, pubDate, category, heroImage, heroAlt, draft } = post.data;
const href = `/blog/${post.slug}`;
---
<article class="blog-card">
  <a class="blog-card-link" href={href} aria-label={title}>
    {heroImage && (
      <div class="blog-card-image">
        <img src={heroImage} alt={heroAlt ?? ''} loading="lazy" />
        {draft && <span class="blog-draft-badge">Draft</span>}
      </div>
    )}
    <div class="blog-card-body">
      <div class="blog-card-meta">
        <span class="blog-card-category">{category}</span>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      </div>
      <h3>{title}</h3>
      <p>{description}</p>
      <span class="blog-card-more">Read article &rarr;</span>
    </div>
  </a>
</article>
