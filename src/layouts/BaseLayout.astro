---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsApp from '../components/WhatsApp.astro';
import { offices, email } from '../data/site.js';

const {
  title = 'Pavilion Master Builders - Premium Construction Excellence',
  description = 'Sustainable building solutions across East Africa — Decra roofing, light gauge steel, Mixx decorative cement, fiber cement, gutters and more.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const origin = Astro.site.origin;

// Built from the same `offices` array the Contact section and Footer use, so an
// address or phone number is only ever edited in one place (src/data/site.js).
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${origin}/#organization`,
      name: 'Pavilion Master Builders',
      url: `${origin}/`,
      email,
      logo: `${origin}/PAV.png`,
      areaServed: { '@type': 'Country', name: 'Kenya' },
    },
    ...offices.map((office) => ({
      '@type': 'LocalBusiness',
      '@id': `${origin}/#${office.short.toLowerCase()}`,
      name: `Pavilion Master Builders — ${office.name}`,
      parentOrganization: { '@id': `${origin}/#organization` },
      url: `${origin}/`,
      email,
      telephone: office.phones.map((phone) => phone.tel),
      address: {
        '@type': 'PostalAddress',
        streetAddress: office.address,
        addressLocality: office.short,
        addressCountry: 'KE',
      },
    })),
  ],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="shortcut icon" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&display=swap" />
  <!-- 6.7.2, not 6.4.0: the X logo (fa-x-twitter) arrived in 6.4.2 and renders
       as an empty box on anything older. Every icon the site already used is
       present in this release, and it is the smaller file. -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

  <!-- TODO: Replace TODO with the Search Console verification token, then verify the property. -->
  <meta name="google-site-verification" content="TODO" />

  <!-- Google Analytics 4. This layout wraps every page, so the tag ships on all of
       them automatically — there is no per-page step. A CI check in deploy.yml
       fails the build if any page in dist/ is missing this ID.
       The Measurement ID is not a secret; it is visible in the page source. -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-N9ZD21PHG1"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-N9ZD21PHG1');
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body>
  <Nav />
  <slot />
  <Footer />
  <WhatsApp />
  <script>
    import '../scripts/main.js';
    import '../scripts/search.js';
  </script>
</body>
</html>
