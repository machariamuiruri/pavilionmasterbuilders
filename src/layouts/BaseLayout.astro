---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsApp from '../components/WhatsApp.astro';
import { offices, email } from '../data/site.js';

const {
  title = 'Pavilion Master Builders - Premium Construction Excellence',
  description = 'Sustainable building solutions across East Africa — Decra roofing, light gauge steel, Mixx decorative cement, fiber cement, gutters and more.',
  // Optional override for the <title> tag only, when the on-page heading is
  // longer than a search result can show. Leave unset and `title` is used.
  seoTitle,
  // Keeps a page out of the index. Excluding a URL from the sitemap does not do
  // this -- it only means the URL is not volunteered, and Google indexes plenty
  // it was never handed. `follow` is deliberate: the page should not rank, but
  // the links on it still pass the crawler through to pages that should.
  noindex = false,
  // Path under public/ for the social-share image (og:image / twitter:image).
  // Defaults to the site's hero photo so every page shares a sensible preview
  // even if it never sets one — a product or blog page overrides it with its
  // own hero so a link to it previews the right subject.
  image = '/assets/hero/hero.jpg',
  // Extra nodes to merge into the page's single JSON-LD @graph (e.g. a
  // product's FAQPage, Product or BreadcrumbList). Kept to one <script> per
  // page rather than one per schema type, since repeated @context blocks are
  // what trip up Google's Rich Results linter on multi-schema pages.
  extraSchema = [],
} = Astro.props;

// Pages pass the bare page title; the company name is appended here rather than
// by each caller. It used to be hardcoded in five places with two different
// separators, which is how four posts ended up over the limit unnoticed.
//
// Google gives a title result roughly 60 characters before cutting it. The
// suffix is 27 of those, so it is added only when the whole thing still fits --
// a brand name chopped mid-word helps nobody, and on a long title the keywords
// are worth more than the company name. Titles that already say "Pavilion
// Master Builders" (the homepage) are left alone rather than repeating it.
const BRAND = 'Pavilion Master Builders';
const SUFFIX = ` | ${BRAND}`;
const TITLE_LIMIT = 60;

const baseTitle = seoTitle ?? title;
const pageTitle = baseTitle.includes(BRAND) || baseTitle.length + SUFFIX.length > TITLE_LIMIT
  ? baseTitle
  : baseTitle + SUFFIX;

const canonical = new URL(Astro.url.pathname, Astro.site);
const origin = Astro.site.origin;
const imageUrl = new URL(image, Astro.site);

// Built from the same `offices` array the Contact section and Footer use, so an
// address or phone number is only ever edited in one place (src/data/site.js).
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${origin}/#organization`,
      name: 'Pavilion Master Builders',
      url: `${origin}/`,
      email,
      logo: `${origin}/PAV.png`,
      areaServed: { '@type': 'Country', name: 'Kenya' },
    },
    ...offices.map((office) => ({
      // Both types are valid together -- GeneralContractor is schema.org's more
      // specific subtype of LocalBusiness, and search engines accept an array
      // here. Listed first so a parser that only reads index 0 still gets the
      // more specific, more useful type.
      '@type': ['GeneralContractor', 'LocalBusiness'],
      '@id': `${origin}/#${office.short.toLowerCase()}`,
      name: `Pavilion Master Builders — ${office.name}`,
      parentOrganization: { '@id': `${origin}/#organization` },
      url: `${origin}/`,
      email,
      telephone: office.phones.map((phone) => phone.tel),
      address: {
        '@type': 'PostalAddress',
        streetAddress: office.address,
        addressLocality: office.short,
        addressCountry: 'KE',
      },
    })),
    ...extraSchema,
  ],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  {/* A noindex page naming itself as the canonical version of something is a
      contradiction, so the tag is emitted only where it means anything. */}
  {!noindex && <link rel="canonical" href={canonical} />}

  <!-- OpenGraph + Twitter Card. Without these, a link dropped into WhatsApp,
       Slack or X renders with no preview at all rather than a wrong one --
       every page gets at least the site's hero photo, see the `image` prop. -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Pavilion Master Builders" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:locale" content="en_KE" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />

  <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="shortcut icon" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&display=swap" />
  <!-- 6.7.2, not 6.4.0: the X logo (fa-x-twitter) arrived in 6.4.2 and renders
       as an empty box on anything older. Every icon the site already used is
       present in this release, and it is the smaller file. -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

  <!-- Google Analytics 4. This layout wraps every page, so the tag ships on all of
       them automatically — there is no per-page step. A CI check in deploy.yml
       fails the build if any page in dist/ is missing this ID.
       The Measurement ID is not a secret; it is visible in the page source. -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-N9ZD21PHG1"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-N9ZD21PHG1');
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body>
  <Nav />
  <slot />
  <Footer />
  <WhatsApp />
  <script>
    import '../scripts/main.js';
    import '../scripts/search.js';
  </script>
</body>
</html>
